        "subfields": [
          {"name": "surface_espace_vert", "label": "Surface des espaces verts (en ares, 1a=100m²)", "type": "spinbox", "default": 0},
          {"name": "has_arrosage_automatique", "label": "Présence d’un arrosage automatique", "type": "checkbox", "default": false},
          {"name": "nb_terrasses", "label": "Nombre de terrasses extérieures", "type": "spinbox", "default": 0}
        ]
      },
      {
        "name": "occupation",
        "label": "Type d’occupation du bâtiment",
        "type": "combobox",
        "options": ["Temps plein (jour)", "Temps partiel", "24h/24", "Week-end compris", "Autre"],
        "default": "Temps plein (jour)"
