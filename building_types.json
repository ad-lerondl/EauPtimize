      {"name": "surface_totale", "label": "Surface totale de l’immeuble (m²)", "type": "spinbox", "default": 0},
      {
        "name": "type_activite",
        "label": "Type d’activité principale",
        "type": "combobox",
        "options": ["Administratif", "Tertiaire (IT, finance…)", "Médical", "Co-working", "Mixte", "Autre"],
        "default": "Administratif"
      },
      {
        "name": "parties_communes",
        "label": "Caractéristiques des parties communes",
