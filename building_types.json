        "text_button": "Ajouter une unité spécifique",
        "label": "Utilisation spécifique de l’eau dans certaines unités (optionnel)",
        "type": "list",
        "subfields": [
          {"name": "nb_unites_specifiques", "label": "Nombre d’unités concernées", "type": "spinbox", "default": 0},
