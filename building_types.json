{
  "appartement": {
    "name": "Appartements",
    "description": "Immeuble résidentiel avec des habitations individuelles ou collectives.",
    "fields": [
      {"name": "nb_habitants", "label": "Nombre total d'habitants estimés", "type": "spinbox", "default": 0},
      {"name": "nb_appartements", "label": "Nombre d'appartements", "type": "spinbox", "default": 0},
      {"name": "nb_etages", "label": "Nombre d'étages", "type": "spinbox", "default": 1},
      {"name": "surface_toit", "label": "Surface du toit (m²)", "type": "spinbox", "default": 0},
      {"name": "jardin", "label": "Surface du jardin le cas échéant (en ares. 1a = 100 m²)", "type": "spinbox", "default": 0},
      {
        "name": "type_appartements",
        "label": "Type global des appartements",
        "type": "combobox",
        "options": ["Studios", "T1-T2", "T3-T4", "T5 et plus", "HLM", "Résidence haut standing"],
        "default": "T3-T4"
      },
      {
        "name": "parties_communes",
        "label": "Caractéristiques des parties communes",
        "type": "list",
        "subfields": [
          {"name": "surface_commune", "label": "Superficie des parties communes (m²)", "type": "spinbox", "default": 0},
          {"name": "nb_machine_a_laver", "label": "Nombre de machines à laver mises à disposition", "type": "spinbox", "default": 0},
          {"name": "nb_seche_linge", "label": "Nombre de sèche-linges mis à disposition", "type": "spinbox", "default": 0},
          {"name": "nb_toilettes_communes", "label": "Nombre de toilettes communes (s'il y a lieu)", "type": "spinbox", "default": 0}
        ]
      },
      {
        "name": "foyers",
        "optional": true,
        "text_button": "Ajouter un foyer",
        "label": "Caractéristiques types des appartements",
        "type": "list",
        "subfields": [
          {"name": "surface_foyer", "label": "Surface moyenne de l'appartement (m²)", "type": "spinbox", "default": 0},
          {"name": "nb_WC", "label": "Nombre moyen de toilettes", "type": "spinbox", "default": 1},
          {"name": "nb_salles_de_bain", "label": "Nombre moyen de salles de bain", "type": "spinbox", "default": 1},
          {"name": "is_cuisine", "label": "Présence d'une cuisine", "type": "checkbox", "default": true},
          {"name": "is_baignoire", "label": "Présence d'une baignoire", "type": "checkbox", "default": false},
          {"name": "nb_apparts", "label": "Nombre d'appartements avec ces caractéristiques", "type": "spinbox", "default": 0}
        ]
      },
      {
        "name": "espaces_exterieurs",
        "label": "Éléments extérieurs utilisant potentiellement de l'eau",
        "type": "list",
        "subfields": [
          {"name": "nb_balcons_arrosables", "label": "Nombre de balcons avec arrosage", "type": "spinbox", "default": 0},
          {"name": "nb_jardins_privés", "label": "Nombre de jardins privatifs", "type": "spinbox", "default": 0},
          {"name": "has_arrosage_automatique", "label": "Présence d’un arrosage automatique", "type": "checkbox", "default": false}
        ]
      },
      {
        "name": "usage_batiment",
        "label": "Usage principal du bâtiment",
        "type": "combobox",
        "options": ["Résidentiel permanent", "Résidence secondaire", "Location saisonnière", "Mixte", "Autre"],
        "default": "Résidentiel permanent"
      }
    ]
  },

  "bureaux": {
