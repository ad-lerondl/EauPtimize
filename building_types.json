        "subfields": [
          {"name": "surface_commune", "label": "Superficie des parties communes (m²)", "type": "spinbox", "default": 0},
          {"name": "nb_cuisinettes", "label": "Nombre de kitchenettes ou espaces repas", "type": "spinbox", "default": 0},
          {"name": "nb_toilettes", "label": "Nombre total de toilettes", "type": "spinbox", "default": 0},
          {"name": "nb_salles_reunion", "label": "Nombre de salles de réunion", "type": "spinbox", "default": 0}
